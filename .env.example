# Required
ADMIN_EMAIL=               # the author's email; only this account can open /write (comma-separate several)
LOGIN_SLUG=                # the secret sign-in path, /<LOGIN_SLUG> (8+ of A-Z a-z 0-9 _ -; openssl rand -hex 9). No /login exists.
NEON_AUTH_COOKIE_SECRET=   # signs cached session cookies, 32+ chars (openssl rand -base64 32)
NEON_AUTH_BASE_URL=        # Neon Auth URL; `neon deploy` / `neon env pull` writes it
OPENROUTER_API_KEY=        # https://openrouter.ai/keys
DATABASE_URL=              # Neon Postgres, pooled (-pooler). `neon deploy` / `neon env pull` writes it.

BLOB_READ_WRITE_TOKEN=     # Vercel Blob. On Vercel: Storage → Blob → connect; it sets this for you.

# Optional
GITHUB_TOKEN=              # fine-grained token with read-only "Contents" + "Metadata"; lists your private repos, raises rate limits
# MODEL_CODE=anthropic/claude-sonnet-5.5
# MODEL_WRITING=anthropic/claude-opus-5.5
# MODEL_FAST=deepseek/deepseek-v4.1-flash
# MODEL_IMAGE=google/gemini-3.1-flash-image
# MODEL_MOTION=anthropic/claude-sonnet-5.5
# MODEL_VIDEO=google/veo-3.1-fast
# MODEL_FACTCHECK=anthropic/claude-sonnet-5.5:online
# AI_MOCK=1                # fake AI replies for local testing, no key needed
